  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@provenance/core": "workspace:*",
    "@provenance/sources": "workspace:*",
    "@types/node": "24.10.1",
    "eslint": "10.9.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "tsx": "4.20.6",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  }
}
